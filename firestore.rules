rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function bootstrapAdminEmail() {
      return exists(/databases/$(database)/documents/config/security)
        ? get(/databases/$(database)/documents/config/security).data.bootstrapAdminEmail
        : null;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && bootstrapAdminEmail() != null
        && request.auth.token.email == bootstrapAdminEmail()
        && request.auth.token.email_verified == true;
    }

    function isNotBlocked(data) {
      return !(data.blocked == true || data.blocked == "true");
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /publicUsers/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /config/security {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && !exists(/databases/$(database)/documents/config/security)
        && request.resource.data.bootstrapAdminEmail == request.auth.token.email
        && request.resource.data.blocked == null
        && request.resource.data.keys().hasOnly(["bootstrapAdminEmail", "createdAt", "updatedAt"]);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && (
          request.resource.data.role == "user" ||
          (request.resource.data.role == "admin" && isBootstrapAdmin())
        )
        && request.resource.data.blocked == false;
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.blocked == resource.data.blocked
      ) || (
        isBootstrapAdmin()
        && request.auth.uid == userId
        && resource.data.role != "admin"
        && request.resource.data.role == "admin"
        && isNotBlocked(resource.data)
        && isNotBlocked(request.resource.data)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["role", "updatedAt"])
      );
      allow delete: if isAdmin();

      match /cards/{cardId} {
        allow read, create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }

      match /contacts/{contactId} {
        allow read, create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /fundingRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
