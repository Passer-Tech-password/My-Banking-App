rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function bootstrapAdminEmail() {
      return exists(/databases/$(database)/documents/config/security)
        ? get(/databases/$(database)/documents/config/security).data.bootstrapAdminEmail
        : null;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && bootstrapAdminEmail() != null
        && request.auth.token.email == bootstrapAdminEmail()
        && request.auth.token.email_verified == true;
    }

    function isNotBlocked(data) {
      return !(data.blocked == true || data.blocked == "true");
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
    }

    match /publicUsers/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /config/security {
      allow read, create, update, delete: if false;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == "user"
        && request.resource.data.blocked == false;
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.blocked == resource.data.blocked
        && request.resource.data.isAdmin == resource.data.isAdmin
      );
      allow delete: if isAdmin();

      match /cards/{cardId} {
        allow read, create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }

      match /contacts/{contactId} {
        allow read, create, update, delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /fundingRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
