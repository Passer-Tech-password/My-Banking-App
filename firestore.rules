rules_version = '2';
 
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAnyAdmin() {
      // 1. Token-based check (fastest, no cost)
      if (isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin'
      )) {
        return true;
      }
      // 2. Database-based check (cached)
      // Note: We use exists() but we must be careful about recursive rules.
      // Users can read their own doc, so exists() should work for them.
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == "admin" ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
        );
    }

    // Top-level match for public user profiles
    match /publicUsers/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow write: if isAnyAdmin();
    }

    match /config/security {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Use explicit get/list to avoid any ambiguity
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAnyAdmin());
      allow list: if isAnyAdmin(); // Only admins should list ALL users
      allow write: if isAnyAdmin();
      
      match /cards/{cardId} {
        // Users can read their own cards; admins can do anything
        allow get: if isAuthenticated() && (request.auth.uid == userId || isAnyAdmin());
        allow list: if isAuthenticated() && (request.auth.uid == userId || isAnyAdmin());
        allow write: if isAnyAdmin();
      }

      allow create: if isOwner(userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "user"
        && request.resource.data.blocked == false
        && (request.resource.data.isAdmin == false || !(request.resource.data.keys().hasAny(["isAdmin"])));

      allow update: if isOwner(userId)
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.blocked == resource.data.blocked
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.balance == resource.data.balance
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName", "firstName", "middleName", "lastName",
          "photoURL", "image", "phone", "mobile", "address",
          "city", "state", "zipCode", "dob", "passportUrl",
          "accountType", "currency", "ssnPin", "updatedAt",
          "settings", "monthlyBudget", "dailyTransferLimit", "photoVersion",
          "virtualCardStatus", "virtualCardApproved"
        ]);
      allow delete: if false;
 
       match /contacts/{contactId} {
         allow read, write: if isOwner(userId) || isAnyAdmin();
       }
     }

    match /transactions/{txId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAnyAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAnyAdmin());
      allow write: if isAnyAdmin();
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.status == "pending" || request.resource.data.status == "completed");
    }

    match /fundingRequests/{requestId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAnyAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAnyAdmin());
      allow write: if isAnyAdmin();
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.status == "pending" || request.resource.data.status == "approved");
    }

    match /cardRequests/{requestId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAnyAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAnyAdmin());
      allow write: if isAnyAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == "pending";
      allow update: if isAnyAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "cardId"]);
    }

    match /subscribers/{subscriberId} {
      allow read: if isAnyAdmin();
      allow create, update, delete: if false;
    }

    match /contactMessages/{messageId} {
      allow read: if isAnyAdmin();
      allow create, update, delete: if false;
    }
  }
}
